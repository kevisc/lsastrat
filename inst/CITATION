citHeader("To cite lsastrat in publications use:")

ver <- meta$Version
year <- sub("-.*", "", meta$Date)
if (length(year) == 0L || is.na(year) || !nzchar(year)) {
  year <- format(Sys.Date(), "%Y")
}

bibentry(
  bibtype  = "Manual",
  title    = "{lsastrat}: Stratification and Inequality Metrics for Large-Scale Assessment Data",
  author   = person("Kevin", "Schoenholzer",
                    comment = c(ORCID = "0000-0001-9892-5869")),
  year     = year,
  note     = paste("R package version", ver),
  doi      = "10.5281/zenodo.20506657",
  url      = "https://kevinschoenholzer.com/lsastrat/",
  textVersion = paste0(
    "Schoenholzer, K. (", year, "). lsastrat: Stratification and Inequality ",
    "Metrics for Large-Scale Assessment Data. R package version ", ver, ". ",
    "https://doi.org/10.5281/zenodo.20506657"
  )
)
